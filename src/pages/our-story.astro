---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { Image } from 'astro:assets';
import pondPostcard from '../assets/historic/pond-postcard.jpg';
import garagePostOffice from '../assets/historic/garage-post-office-winter.jpg';
import millWorkersGroup from '../assets/historic/mill-workers-group.jpg';
import victorianFarmhouse from '../assets/historic/victorian-farmhouse.jpg';
import woolenMill from '../assets/historic/woolen-mill.jpg';
import millUnderConstruction from '../assets/historic/mill-under-construction.jpg';
import mainStreet from '../assets/historic/main-street.jpg';
import buildingFire from '../assets/historic/building-fire.jpg';
import villagePostcardCars from '../assets/historic/village-postcard-cars.jpg';
import woolenMillTinted from '../assets/historic/woolen-mill-tinted.jpg';
import prayStorePostcard from '../assets/historic/pray-store-postcard.jpg';
import villagePanorama from '../assets/historic/village-panorama.jpg';

// Historic photos for the gallery at the bottom of the page — photographed
// from the village's own archive of old prints and postcards. Add more by
// importing an image above and adding an entry below (image/alt/caption).
// "caption" is intentionally blank for now — leave it "" until real captions
// are written; the gallery just won't show a caption line for that photo.
const historicPhotos = [
	{
		image: pondPostcard,
		alt: 'Sepia-toned postcard captioned "Pond at No. Montpelier, VT" showing the millpond and mill buildings.',
		caption: '',
	},
	{
		image: garagePostOffice,
		alt: 'Winter photo of the North Montpelier Garage and United States Post Office buildings, snow-covered.',
		caption: '',
	},
	{
		image: millWorkersGroup,
		alt: 'Large group photo of mill workers posed outside a mill building.',
		caption: '',
	},
	{
		image: victorianFarmhouse,
		alt: 'Photocopy of a Victorian farmhouse with a wraparound porch.',
		caption: '',
	},
	{
		image: woolenMill,
		alt: 'Black-and-white postcard of the Little Woolen Mfg. Co. mill complex in North Montpelier, Vermont.',
		caption: '',
	},
	{
		image: millUnderConstruction,
		alt: 'Mill building under construction, wooden frame exposed.',
		caption: '',
	},
	{
		image: mainStreet,
		alt: 'Early 1900s photo of a dirt Main Street in North Montpelier, with a church steeple and a boy standing in the road.',
		caption: '',
	},
	{
		image: buildingFire,
		alt: 'A building fire in the village, watched by a crowd of villagers standing on the frozen pond.',
		caption: '',
	},
	{
		image: villagePostcardCars,
		alt: 'Mid-1900s postcard captioned "N. Montpelier, Vt." showing parked cars and village storefronts.',
		caption: '',
	},
	{
		image: woolenMillTinted,
		alt: 'Hand-tinted color postcard of the Little Woolen Mfg. Co. mill complex.',
		caption: '',
	},
	{
		image: prayStorePostcard,
		alt: 'Postcard of the "Geo. J. Pray" storefront and an inn, with a man and his dog sitting on the porch steps.',
		caption: '',
	},
	{
		image: villagePanorama,
		alt: 'Panoramic postcard of North Montpelier village with the church steeple, mill buildings, and mountains beyond.',
		caption: '',
	},
];
---

{
	/* All the page text lives right in this file — the page heading below, and
	   the paragraphs further down. There's no separate content file for this
	   one; just edit the strings directly. The "North Montpelier" in the
	   title below uses a non-breaking space (looks like a normal space) so
	   the village's name never splits across two lines. */
}
<BaseLayout title="Our Story" description="The history and identity of North Montpelier, Vermont.">
	<PageIntro eyebrow="Our Story" title="How a mill village became North Montpelier" />

	<article class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
		<div class="prose prose-neutral max-w-none font-display text-lg leading-relaxed text-ink">
			<p class="text-sm font-sans uppercase tracking-wide text-brick">
				[PLACEHOLDER — replace with real history narrative from capstone research]
			</p>

			<p>
				North Montpelier grew up around the dam and mills on the Winooski River's north branch,
				where water power once turned lumber and grain into the goods that built the surrounding
				towns. What's left today is a village still shaped by that history — the pond behind the
				dam, the worn granite foundations, and a tight cluster of homes, churches, and civic
				buildings that has outlasted the industry that built it.
			</p>

			<h2 class="font-display text-2xl font-semibold text-forest">The mill years</h2>
			<p>
				[PLACEHOLDER] A paragraph or two on the founding of the mills, who built them, and what
				they produced — pulled from the capstone research notes.
			</p>

			<h2 class="font-display text-2xl font-semibold text-forest">A village, not a town</h2>
			<p>
				[PLACEHOLDER] Explain North Montpelier's status as an unincorporated village within the
				Town of East Montpelier, and why that distinction matters for how the community organizes itself
				today.
			</p>

			<h2 class="font-display text-2xl font-semibold text-forest">North Montpelier today</h2>
			<p>
				[PLACEHOLDER] Bridge from history to the present-day character of the village — who lives
				here now, what the community values, and how it's changing.
			</p>
		</div>
	</article>

	{
		/* Historic photo gallery — photographed from the village's own archive.
		   Captions are edited in the historicPhotos array above, not here. */
	}
	<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
		<h2 class="mb-2 font-display text-2xl font-semibold text-forest">From the archives</h2>
		<p class="mb-8 max-w-2xl text-granite">A few photos and postcards from the village's own history.</p>

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				historicPhotos.map((photo) => (
					<figure class="overflow-hidden rounded-lg border border-granite-light/60 bg-card shadow-sm">
						<Image src={photo.image} alt={photo.alt} width={640} height={480} class="aspect-[4/3] w-full object-cover" />
						{photo.caption && <figcaption class="p-4 text-sm text-granite">{photo.caption}</figcaption>}
					</figure>
				))
			}
		</div>
	</section>
</BaseLayout>
