---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SubstackPostCard from '../../components/SubstackPostCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { fetchSubstackPosts, SUBSTACK_PUBLICATION_URL } from '../../lib/substack';
import { getCollection } from 'astro:content';

// Only the 3 most recent Substack posts show on this page — bump this
// number to show more.
const posts = await fetchSubstackPosts(3);

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="News & Projects" description="Village news from Substack and ongoing grant/project updates for North Montpelier.">
	<PageIntro eyebrow="News & Projects" title="Village news and ongoing projects" />

	{
		/* News POSTS themselves are NOT edited here — they're pulled live from
		   the Substack feed at build time (see src/lib/substack.ts). Write and
		   publish a post on Substack, then rebuild the site, to add one. */
	}
	<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
		<div class="mb-8 flex items-end justify-between">
			<h2 class="font-display text-2xl font-semibold text-forest">News</h2>
			<a href={SUBSTACK_PUBLICATION_URL} target="_blank" rel="noopener noreferrer" class="font-semibold text-brick hover:text-brick-dark">
				Read &amp; subscribe on Substack &rarr;
			</a>
		</div>

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => <SubstackPostCard post={post} />)}
		</div>
	</section>

	{
		/* Project cards come from markdown files in src/content/projects/*.md —
		   add/edit/delete files there to change what shows here. */
	}
	<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
		<h2 class="mb-8 font-display text-2xl font-semibold text-forest">Projects</h2>

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>

		{projects.length === 0 && (
			<p class="text-granite">No projects yet — add one via the CMS.</p>
		)}
	</section>
</BaseLayout>
