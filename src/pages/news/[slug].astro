---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { title, date, status, cover, coverAlt, link, linkLabel } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={project.data.summary}>
	<article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
		<span class="mb-6 inline-block rounded-full bg-forest/10 px-2 py-0.5 text-xs font-semibold text-forest">{status}</span>

		<h1 class="font-display text-4xl font-semibold text-forest">{title}</h1>
		<time datetime={date.toISOString()} class="mt-2 block text-sm uppercase tracking-wide text-granite">
			{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
		</time>

		{
			cover && (
				<Image
					src={cover}
					alt={coverAlt ?? ''}
					width={960}
					height={540}
					class="my-8 w-full rounded-lg object-cover"
				/>
			)
		}

		<div class="prose prose-neutral max-w-none font-display leading-relaxed text-ink">
			<Content />
		</div>

		{
			link && (
				<a href={link} target="_blank" rel="noopener noreferrer" class="mt-8 inline-block font-semibold text-brick hover:text-brick-dark">
					{linkLabel ?? 'Learn more'} &rarr;
				</a>
			)
		}

		<a href="/news" class="mt-10 block font-semibold text-brick hover:text-brick-dark">&larr; Back to News & Projects</a>
	</article>
</BaseLayout>
