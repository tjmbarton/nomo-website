---
const calendarSrc =
	'https://calendar.google.com/calendar/embed?src=9565daa7cd451ca2ee448cf0731dd55ce0b9bf5cb34016ed6ccbda35aa58f1a4%40group.calendar.google.com&ctz=America%2FNew_York';
---

<div class="overflow-hidden rounded-lg border border-granite-light/60 bg-card">
	<iframe
		title="North Montpelier community events calendar"
		src={calendarSrc}
		style="border-width:0"
		width="100%"
		height="600"
		scrolling="no"
		loading="lazy"
	></iframe>
</div>
