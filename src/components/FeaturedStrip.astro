---
import { fetchSubstackPosts } from '../lib/substack';
import SubstackPostCard from './SubstackPostCard.astro';

const posts = await fetchSubstackPosts(3);
---

{
	posts.length > 0 && (
		<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
			<div class="mb-8 flex items-end justify-between">
				<h2 class="font-display text-3xl font-semibold text-forest">Latest from the village</h2>
				<a href="/news" class="font-semibold text-brick hover:text-brick-dark">
					All news &amp; projects &rarr;
				</a>
			</div>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => <SubstackPostCard post={post} />)}
			</div>
		</section>
	)
}
