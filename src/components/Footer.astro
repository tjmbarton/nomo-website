---
import NewsletterSignup from './NewsletterSignup.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-granite-light/60 bg-forest text-paper">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
		{/* Footer blurb, left column — edit this paragraph directly */}
		<div>
			<p class="font-display text-lg font-semibold">North Montpelier, Vermont</p>
			<p class="mt-2 max-w-xs text-sm text-paper/80">
				A village on the pond, past the old mill. This site is community-run — it is not a
				municipal government website.
			</p>
		</div>

		{/* Footer link list — mirrors the header nav, but edited separately here */}
		<nav aria-label="Footer">
			<p class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-brass-light">Explore</p>
			{/* 2 columns x 3 rows (fills top-to-bottom, then next column) — keeps this list roughly as tall as the other two footer columns instead of one long stack */}
			<ul class="grid grid-flow-col grid-cols-2 grid-rows-3 gap-x-8 gap-y-2 text-sm text-paper/85">
				<li><a class="hover:text-brass-light" href="/our-story">Our Story</a></li>
				<li><a class="hover:text-brass-light" href="/explore">Explore &amp; Visit</a></li>
				<li><a class="hover:text-brass-light" href="/community">Community Resources</a></li>
				<li><a class="hover:text-brass-light" href="/events">Events</a></li>
				<li><a class="hover:text-brass-light" href="/news">News &amp; Projects</a></li>
				<li><a class="hover:text-brass-light" href="/contact">Get Involved</a></li>
			</ul>
		</nav>

		<NewsletterSignup compact />
	</div>

	<div class="border-t border-paper/15">
		<p class="mx-auto max-w-6xl px-4 py-4 text-xs text-paper/60 sm:px-6">
			&copy; {year} North Montpelier Community. Site content maintained by local volunteers.
		</p>
	</div>
</footer>
