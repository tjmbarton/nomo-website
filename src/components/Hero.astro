---
// Homepage-only: the tall image hero is intentionally exclusive to "/" so the
// dark green band reads as an arrival moment rather than a repeated page
// banner. Every other page uses PageIntro.astro instead for a seamless
// paper-to-paper transition straight out of the header.
interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	image?: string;
	imageAlt?: string;
}

const { eyebrow, title, subtitle, image, imageAlt = '' } = Astro.props;
---

<section class="relative flex min-h-[85vh] items-end overflow-hidden bg-forest">
	{
		image ? (
			<img
				src={image}
				alt={imageAlt}
				class="absolute inset-0 h-full w-full object-cover"
				loading="eager"
				fetchpriority="high"
			/>
		) : (
			<div class="absolute inset-0 bg-gradient-to-br from-forest to-forest-dark" />
		)
	}
	<div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/20 to-transparent" aria-hidden="true"></div>

	<div class="relative mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
		{eyebrow && (
			<p class="mb-2 font-sans text-sm font-semibold uppercase tracking-widest text-brass-light">{eyebrow}</p>
		)}
		<h1 class="max-w-3xl font-display text-4xl font-semibold text-paper sm:text-5xl md:text-6xl">{title}</h1>
		{subtitle && <p class="mt-4 max-w-xl text-lg text-paper/90">{subtitle}</p>}
		<slot />
	</div>
</section>
